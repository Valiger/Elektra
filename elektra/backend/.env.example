# ============================================================
# Elektra Backend – Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit the .env file.
# ============================================================

# --- Application -------------------------------------------
# Strong random secret (generate with: openssl rand -hex 32)
SECRET_KEY=

# Algorithm used for JWT signing
ALGORITHM=HS256

# Access-token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database ----------------------------------------------
# SQLite (local dev):    sqlite:///./elektra.db
# PostgreSQL (prod):     postgresql+psycopg2://user:password@host/dbname
DATABASE_URL=sqlite:///./elektra.db

# --- File Uploads ------------------------------------------
UPLOAD_DIR=./uploads

# --- CORS / Frontend ---------------------------------------
# URL of the deployed frontend (no trailing slash)
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Comma-separated list of additional allowed origins (optional)
ALLOWED_ORIGINS=

# --- Google Cloud Vision -----------------------------------
# Path to your GCP service-account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=./elektra-vision-key.json

# --- Google Gemini -----------------------------------------
GEMINI_API_KEY=
